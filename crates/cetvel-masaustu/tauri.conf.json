{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cetvel",
  "mainBinaryName": "cetvel-masaustu",
  "identifier": "dev.cetvel.masaustu",
  "build": {
    "frontendDist": "../../apps/arayuz",
    "beforeBuildCommand": "cargo build --release --locked -p cetvel"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Cetvel",
    "copyright": "Cetvel; MIT veya Apache-2.0 lisansı",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../paketleme/nsis/lisans-sayfasi.txt",
    "category": "Utility",
    "shortDescription": "Yapay zekâ kota ölçer",
    "longDescription": "Cetvel, yapay zekâ araçlarının kota ve bakiye durumunu yerelde ölçer; tepside ve masaüstünde gösterir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../../paketleme/nsis/kancalar.nsh"
      }
    }
  }
}
